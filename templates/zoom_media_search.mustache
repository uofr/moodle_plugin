<div class="row mx-0">
    <div class="col-xs-12 col-md-8 col-lg-4">
        <form class="mt-3 mb-3" data-form="zoom-media-search-form">
            <div class="d-flex">
                <div class="input-group searchbar zoom-media-searchbar w-100">
                    <input
                        type="text"
                        class="form-control withclear rounded"
                        autocomplete="off"
                        name="zoom-media-search-text"
                        placeholder="{{$placeholdertext}}{{/placeholdertext}}"/>
                    <button class="btn btn-clear" type="reset" style="display: none;">
                        {{#pix}}zoom_video_search_clear, local_mymedia{{/pix}}
                    </button>
                </div>
                <button class="btn btn-primary ml-1" type="submit">{{#str}}search{{/str}}</button>
            </div>
        </form>
    </div>
</div>

{{#js}}
    require(['local_mymedia/zoom_media_search'], function(zoomMediaSearch) {
        zoomMediaSearch.init('[data-form="zoom-media-search-form"]');
    });
{{/js}}