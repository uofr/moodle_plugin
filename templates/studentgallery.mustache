<div id="mod_kalvidassign_gallery" data-scroll="{{infinitescroll}}" class="container" data-vid="{{{vidassignid}}}" data-course="{{course}}" data-context="{{context}}" data-cmid="{{cmid}}">

    {{#teaser}}
    <h2 class="fs-2 fw-semibold text-dark border-bottom border-3 border-primary pb-2 mb-4 d-flex align-items-center gap-2">
        <i class="fa fa-film text-primary" aria-hidden="true"></i>
        Submission Gallery
    </h2>
    {{/teaser}}

    <div class="row">
        {{#entries}}
        <div id="{{itemid}}" class="card bg-light m-3 kalvidassign_videocards" style="width: 15rem;">
            <img id="{{{id}}}" class="card-img-top kalvidassign_thumbnail" src='{{{thumbnailUrl}}}/width/640/height/360'>

            <div class="hide url"
                data-comment="{{commentid}}"
                data-totallikes={{totallikes}}
                data-liked='{{liked}}'
                data-value='{{url}}'
                data-width={{{width}}}
                data-height={{{height}}}>
            </div>

            <div class="card-body">
                <p id="thumbcreator">Creator: {{creator}}</p>
                <h5 id="thumbtitle" class="card-title fw-semibold text-truncate" title="{{name}}">
                    {{name}}
                </h5>
            </div>
        </div>
        {{/entries}}

        {{#teaser}}
        <a class="card m-3 mod-kalvidassign-viewmore p-5 feature text-center" href="{{teaserurl}}" style="width: 15rem;">
            <div class="feature-icon fs-2">
                <i class="fa fa-plus-circle fa-3x" aria-hidden="true"></i>
            </div>
            <br>
            <h4>View More</h4>
        </a>
        {{/teaser}}
    </div>
</div>

{{#js}}
require(['mod_kalvidassign/fullscreen', 'mod_kalvidassign/lazyload'], function(fullscreen, lazyload) {
    fullscreen.init({{allowcomments}}, {{allowlikes}});
    {{^teaser}} lazyload.init();{{/teaser}}
});
{{/js}}
