{{!
    @template local_mymedia/kaltura_archive_cards
    Partial template containing just the card columns for infinite scrolling.
}}
{{#cards}}
<div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex align-items-stretch kaltura-card-item">
    <div class="card w-100 h-100 shadow-sm border-0 d-flex flex-column">
        
        <!-- Thumbnail Container -->
        <div class="position-relative bg-dark d-flex align-items-center justify-content-center" 
             style="padding-top: 56.25%; overflow: hidden; border-top-left-radius: .25rem; border-top-right-radius: .25rem;">
            
            <!-- Fallback SVG Placeholder Icon -->
            <div class="position-absolute text-muted" style="top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.3;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-play-btn" viewBox="0 0 16 16">
                    <path d="M6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814l-3.5-2.5z"/>
                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm15 0a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                </svg>
            </div>

            <!-- Video Thumbnail Image -->
            <img src="{{{thumburl}}}" 
                 alt="" 
                 class="position-absolute w-100 h-100" 
                 style="top: 0; left: 0; object-fit: cover;"
                 onerror="this.style.display='none'">
            
            <!-- KA Source Badge (Top Left) -->
            <span class="badge badge-dark position-absolute font-weight-bold" style="top: 10px; left: 10px; opacity: 0.9; border: 1px solid rgba(255,255,255,0.2);">
                KA
            </span>

            <!-- Captions / Status Badge (Top Right) -->
            <div class="position-absolute" style="top: 10px; right: 10px;">
                {{#has_captions}}
                    <span class="badge badge-info" title="Captions available">CC ({{caption_count}})</span>
                {{/has_captions}}
                {{#is_pending}}
                    <span class="badge badge-warning">Processing</span>
                {{/is_pending}}
                {{#is_failed}}
                    <span class="badge badge-danger">Failed</span>
                {{/is_failed}}
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body d-flex flex-column justify-content-between p-3 flex-grow-1">
            <div>
                <h6 class="card-title font-weight-bold text-truncate mb-2" title="{{title}}">
                    {{title}}
                </h6>
                <div class="text-muted small" style="font-size: 0.8rem; line-height: 1.4;">
                    <div><strong>Created:</strong> {{timecreated}}</div>
                    <div><strong>Modified:</strong> {{timemodified}}</div>
                    {{#filesize}}<div><strong>Size:</strong> {{filesize}}</div>{{/filesize}}
                </div>
            </div>
        </div>

        <!-- Card Footer Action Bar (Tinted with bg-light) -->
        <div class="card-footer bg-light border-top py-2 px-3 d-flex justify-content-between align-items-center">
            {{#is_ready}}
                <!-- Watch Button triggers Bootstrap Modal -->
                <button type="button" 
                        class="btn btn-sm btn-outline-dark px-3 watch-archive-btn"
                        data-toggle="modal" 
                        data-target="#kalturaArchiveModal"
                        data-title="{{{title}}}"
                        data-video="{{{videourl}}}"
                        data-poster="{{{thumburl}}}"
                        {{#captionurl}}data-caption="{{{captionurl}}}"{{/captionurl}}>
                    <i class="fa fa-play mr-1"></i> Watch
                </button>

                <!-- Download Dropdown Menu -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border text-dark dropdown-toggle px-2" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Download Options">
                        <i class="fa fa-download"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow-sm">
                        <a class="dropdown-item small py-1" href="{{{downloadurl}}}">
                            <i class="fa fa-file-video-o mr-2 text-primary"></i> Video (MP4)
                        </a>
                        <a class="dropdown-item small py-1" href="{{{thumbdownloadurl}}}">
                            <i class="fa fa-file-image-o mr-2 text-success"></i> Thumbnail (.jpg)
                        </a>
                        {{#has_captions}}
                        <a class="dropdown-item small py-1" href="{{{captiondownloadurl}}}">
                            <i class="fa fa-file-text-o mr-2 text-info"></i> Captions (.vtt)
                        </a>
                        {{/has_captions}}
                    </div>
                </div>
            {{/is_ready}}
            {{^is_ready}}
                <span class="text-muted small font-italic">Archive Pending</span>
            {{/is_ready}}
        </div>

    </div>
</div>
{{/cards}}