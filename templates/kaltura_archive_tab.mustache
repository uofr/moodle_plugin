{{!
    @template local_mymedia/kaltura_archive_tab
    Polished card grid layout with an in-place Video Player Modal and Infinite Scroll.
}}

<!-- Search Bar -->
<div class="row mb-4 mt-2">
    <h5 class="col-md-12">Videos archived from the Kaltura streaming service</h5>
    <div class="col-12 col-md-6 col-lg-5">
        <form method="get" action="zoom_media.php" class="input-group shadow-sm">
            <input type="hidden" name="activetab" value="kaltura">
            <input type="text" 
                   name="search" 
                   class="form-control border-right-0 rounded-left" 
                   placeholder="Search by video title..." 
                   value="{{search}}">
            <div class="input-group-append">
                <button type="submit" class="btn btn-success px-3">
                    <i class="fa fa-search mr-1"></i> Search
                </button>
                {{#search}}
                    <a href="zoom_media.php?activetab=kaltura" class="btn btn-outline-secondary d-flex align-items-center px-3" title="Clear Search">
                        <i class="fa fa-times"></i>
                    </a>
                {{/search}}
            </div>
        </form>
    </div>
</div>

{{#has_videos}}
<!-- Video Grid Container -->
<div class="row" id="kaltura-card-grid">
    {{> local_mymedia/kaltura_archive_cards }}
</div>

<!-- Infinite Scroll Sentinel & Loading Spinner -->
<div id="kaltura-scroll-sentinel" class="text-center py-4 w-100" data-hasmore="{{#hasmore}}true{{/hasmore}}{{^hasmore}}false{{/hasmore}}">
    <div id="kaltura-scroll-spinner" style="display: none;">
        <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
        <div class="small text-muted mt-2">Loading more videos...</div>
    </div>
</div>
{{/has_videos}}

{{^has_videos}}
<div class="alert alert-light text-center py-5 border">
    <h5>No archived Kaltura videos found</h5>
    <p class="text-muted mb-0">Videos migrated or downloaded from your Kaltura archive will appear here.</p>
</div>
{{/has_videos}}

<!-- Bootstrap Video Player Modal -->
<div class="modal fade" id="kalturaArchiveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content bg-dark border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title text-white text-truncate font-weight-bold pr-3" id="kalturaArchiveModalTitle"></h6>
                <button type="button" class="close text-white opacity-1" data-dismiss="modal" aria-label="Close" style="opacity: 0.8;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
           <div class="modal-body p-3">
                <div id="kalturaModalPlayerContainer" class="position-relative bg-black" style="border-radius: 4px; overflow: hidden; aspect-ratio: 16/9; width: 100%;">
                    <video id="kalturaArchiveVideoPlayer" class="w-100 h-100 d-block" controls preload="none" style="background: #000;">
                        Your browser does not support HTML5 video.
                    </video>
                </div>
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['jquery'], function($) {

// Handle Copy to Clipboard for YouTube links & embeds
    $(document).on('click', '.copy-to-clipboard-btn', function(e) {
        e.preventDefault();
        var btn = $(this);
        var textToCopy = btn.data('copy');
        
        if (navigator.clipboard) {
            navigator.clipboard.writeText(textToCopy).then(function() {
                // Temporarily swap button content for visual feedback
                var originalHtml = btn.html();
                btn.html('<i class="fa fa-check mr-2 text-success"></i> Copied!');
                setTimeout(function() {
                    btn.html(originalHtml);
                }, 1500);
            }).catch(function(err) {
                console.error('Could not copy text: ', err);
            });
        } else {
            // Fallback for older browsers
            var tempInput = $('<input>');
            $('body').append(tempInput);
            tempInput.val(textToCopy).select();
            document.execCommand('copy');
            tempInput.remove();
            
            var originalHtml = btn.html();
            btn.html('<i class="fa fa-check mr-2 text-success"></i> Copied!');
            setTimeout(function() {
                btn.html(originalHtml);
            }, 1500);
        }
    });

    // "Migrate to Zoom": queue this archived video for upload to Zoom, then
    // follow its progress live (Queued -> Transferring -> In Zoom).
    var MIGRATE_URL = M.cfg.wwwroot + '/local/mymedia/migrate_entry.php';
    var MIGRATE_POLL_MS = 15000;
    var MIGRATE_POLL_MAX = 2 * 60 * 60 * 1000; // Stop following after 2 hours; a reload resumes.
    var MIGRATE_ACTIVE = ['queued', 'uploading', 'transferring'];
    var migrateBtnHtml = '<i class="fa fa-cloud-upload"></i>';
    // Same as kaltura_migration::STATE_ICONS.
    var MIGRATE_ICONS = {queued: 'fa-spinner fa-spin', uploading: 'fa-spinner fa-spin', transferring: 'fa-spinner fa-spin',
        inzoom: 'fa-check', failed: 'fa-exclamation-circle', transferfailed: 'fa-exclamation-circle', nozoom: 'fa-ban'};

    function showMigrationState(badge, r) {
        badge.removeClass('d-none badge-danger badge-warning badge-success badge-info badge-secondary')
            .addClass(r.migration_badge || r.badge || 'badge-info')
            .attr('title', r.migration_title || r.message || '')
            .attr('data-state', r.migration_state || '');
        badge.find('.migrate-zoom-label').text(r.migration_label || r.label || '');
        badge.find('.migrate-zoom-icon').attr('class', 'fa ' + (MIGRATE_ICONS[r.migration_state] || '') + ' mr-1 migrate-zoom-icon');
        if (!(r.migration_label || r.label)) {
            badge.addClass('d-none');
        }
        var btn = badge.siblings('.migrate-zoom-btn');
        if (r.needs_migration && !btn.length) {
            $('<button type="button" class="btn btn-sm btn-primary ml-2 px-2 flex-shrink-0 migrate-zoom-btn" title="Migrate to Zoom"></button>')
                .attr('data-entryid', badge.data('entryid')).html(migrateBtnHtml).insertBefore(badge);
        } else if (!r.needs_migration && btn.length) {
            btn.remove();
        }
    }

    function followMigration(badge) {
        if (badge.data('polling')) {
            return;
        }
        badge.data('polling', true);
        var started = Date.now();
        var timer = setInterval(function() {
            if (!document.body.contains(badge[0]) || Date.now() - started > MIGRATE_POLL_MAX) {
                clearInterval(timer);
                badge.data('polling', false);
                return;
            }
            $.ajax({url: MIGRATE_URL, type: 'POST', dataType: 'json',
                data: {action: 'status', entryid: badge.data('entryid'), sesskey: M.cfg.sesskey}
            }).done(function(r) {
                if (!r || !r.ok) {
                    return; // Try again on the next tick.
                }
                showMigrationState(badge, r);
                if (MIGRATE_ACTIVE.indexOf(r.migration_state) === -1) {
                    clearInterval(timer);
                    badge.data('polling', false);
                }
            });
        }, MIGRATE_POLL_MS);
    }

    // Cards already queued or transferring (on load, and after more cards load).
    function followActiveMigrations() {
        $('.migrate-zoom-status').each(function() {
            var badge = $(this);
            if (MIGRATE_ACTIVE.indexOf(String(badge.attr('data-state'))) !== -1) {
                followMigration(badge);
            }
        });
    }
    followActiveMigrations();
    $(document).ajaxComplete(function(event, xhr, settings) {
        if (settings && settings.url && settings.url.indexOf('/local/mymedia/ajax_kaltura.php') !== -1) {
            followActiveMigrations();
        }
    });

    $(document).on('click', '.migrate-zoom-btn', function(e) {
        e.preventDefault();
        var btn = $(this);
        var badge = btn.siblings('.migrate-zoom-status');
        if (!window.confirm('Copy this video to Zoom? It will be added to your Zoom library in the background.')) {
            return;
        }
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        $.ajax({url: MIGRATE_URL, type: 'POST', dataType: 'json',
            data: {entryid: btn.data('entryid'), sesskey: M.cfg.sesskey}
        }).done(function(r) {
            if (r && r.ok) {
                btn.remove();
                showMigrationState(badge, r);
                if (MIGRATE_ACTIVE.indexOf(r.migration_state) !== -1) {
                    followMigration(badge);
                }
            } else if (r && r.migration_state === 'nozoom') {
                // No Zoom account to put it in: show why instead of the button.
                showMigrationState(badge, r);
                window.alert(r.message);
            } else {
                btn.prop('disabled', false).html(migrateBtnHtml);
                window.alert((r && r.message) || 'Could not queue this video.');
            }
        }).fail(function() {
            btn.prop('disabled', false).html(migrateBtnHtml);
            window.alert('Could not queue this video. Please try again.');
        });
    });

    //  Use document delegation so dynamically loaded AJAX cards trigger the modal cleanly
   $(document).on('click', '.watch-archive-btn', function() {
        var btn = $(this);
        var title = btn.data('title');
        var isYoutube = btn.data('isyoutube');
        var container = $('#kalturaModalPlayerContainer');

        $('#kalturaArchiveModalTitle').text(title);

        if (isYoutube || isYoutube === 'true' || isYoutube === true) {
            var ytEmbedUrl = btn.data('youtubeembed');
            
            // Inject YouTube Iframe
            container.html(
                '<iframe src="' + ytEmbedUrl + '" ' +
                'class="w-100 h-100 border-0" ' +
                'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" ' +
                'allowfullscreen style="aspect-ratio: 16/9;">' +
                '</iframe>'
            );
        } else {
            var videoSrc = btn.data('video');
            var posterSrc = btn.data('poster');
            var captionSrc = btn.data('caption');

            // Inject Standard HTML5 Video Player
            container.html(
                '<video id="kalturaArchiveVideoPlayer" class="w-100 h-100 d-block" controls preload="none" style="background: #000;">' +
                '<source src="' + videoSrc + '" type="video/mp4">' +
                'Your browser does not support HTML5 video.' +
                '</video>'
            );

            var videoEl = $('#kalturaArchiveVideoPlayer');
            var videoDOM = videoEl.get(0);
            videoDOM.poster = posterSrc || '';

            if (captionSrc) {
                videoEl.append($('<track>', {
                    kind: 'subtitles',
                    label: 'English CC',
                    srclang: 'en',
                    src: captionSrc,
                    default: true
                }));
            }

            videoDOM.load();
            videoDOM.play().catch(function() {});
        }
    });

   

    // When modal is closed, pause and reset the player
// Clean up player / iframe when modal is closed (stops background audio/video)
    $('#kalturaArchiveModal').on('hidden.bs.modal', function() {
        
        // 1. If Moodle's Video.js was active, pause and dispose of it safely
        if (typeof videojs !== 'undefined' && videojs.getPlayer('kalturaArchiveVideoPlayer')) {
            var vjsPlayer = videojs.getPlayer('kalturaArchiveVideoPlayer');
            vjsPlayer.pause();
            vjsPlayer.dispose(); 
        }

        // 2. Clear out the container so YouTube iframes and standard videos stop playing
        $('#kalturaModalPlayerContainer').empty();
    });

    //  INFINITE SCROLL OBSERVER
    var currentPage = 0;
    var isLoading = false;
    var sentinel = document.getElementById('kaltura-scroll-sentinel');
    var hasMore = ($('#kaltura-scroll-sentinel').data('hasmore') === true || $('#kaltura-scroll-sentinel').data('hasmore') === 'true');

    if (!sentinel || !hasMore) {
        return;
    }

    var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && !isLoading && hasMore) {
            isLoading = true;
            currentPage++;
            $('#kaltura-scroll-spinner').fadeIn(150);

            var searchTerm = $('input[name="search"]').val() || '';

            $.ajax({
                url: M.cfg.wwwroot + '/local/mymedia/ajax_kaltura.php',
                type: 'GET',
                dataType: 'json',
                data: {
                    page: currentPage,
                    search: searchTerm
                },
                success: function(response) {
                    if (response.success && response.html) {
                        $('#kaltura-card-grid').append(response.html);
                        hasMore = response.hasmore;

                        if (!hasMore) {
                            observer.disconnect();
                            $('#kaltura-scroll-sentinel').remove();
                        }
                    } else {
                        hasMore = false;
                        observer.disconnect();
                    }
                },
                complete: function() {
                    isLoading = false;
                    $('#kaltura-scroll-spinner').hide();
                }
            });
        }
    }, {
        rootMargin: '200px' // Start loading 200px before reaching the bottom
    });

    observer.observe(sentinel);
});
{{/js}}